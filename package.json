{
  "name": "azure-devops-mcp-pat",
  "version": "1.0.0",
  "description": "Official Azure DevOps MCP Server deployed on Render via Supergateway (stdio→HTTP bridge)",
  "license": "MIT",
  "author": "ennuiii",
  "homepage": "https://github.com/ennuiii/DevOpsMcpPAT",
  "bugs": "https://github.com/ennuiii/DevOpsMcpPAT/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/ennuiii/DevOpsMcpPAT.git"
  },
  "type": "module",
  "main": "dist/server-web-simple.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "render.yaml",
    "Dockerfile"
  ],
  "scripts": {
    "start": "ADO_MCP_AUTH_TOKEN=${AZURE_DEVOPS_PAT} npx -y supergateway --stdio \"npx -y @azure-devops/mcp ${AZURE_DEVOPS_ORG} --auth-type env\" --port ${PORT:-8000} --outputTransport streamableHttp --streamableHttpPath /mcp --cors --healthEndpoint /health"
  },
  "dependencies": {
    "supergateway": "latest",
    "@azure-devops/mcp": "latest"
  }
}
